{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "table_version": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "region",
              "subdivision"
            ]
          },
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sequence",
          "code",
          "kind",
          "token"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "table_version",
    "authority",
    "license",
    "entries"
  ],
  "additionalProperties": false
}
