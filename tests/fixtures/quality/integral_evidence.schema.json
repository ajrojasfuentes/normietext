{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements",
    "authorized_losses"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "fragments"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "enum": [
              "job_title",
              "job_description",
              "job_criteria_list",
              "job_type",
              "seniority",
              "raw_location"
            ]
          },
          "fragments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "authorized_losses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
