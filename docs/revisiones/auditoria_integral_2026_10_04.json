    "source": "import itertools\nimport json\nfrom pathlib import Path\nfrom normietext import FieldInput, JobField, JobTextNormalizer, SourceFormat\nfrom evaluation.quality import span_errors\n\nn = JobTextNormalizer()\ncontents = ['', 'A', '🇨🇷', 'a\\u0301', '<ul><li>A</li></ul>', '<p>A</p><p>B</p>']\nhtmls = []\nfor a, b in itertools.product(contents, repeat=2):\n    for template in ['<table><tr><td>{a}</td><td>{b}</td></tr></table>', '<dl><dt>{a}</dt><dd>{b}</dd></dl>', '<ul><li>{a}</li><li>{b}</li></ul>']:\n        htmls.append(template.format(a=a,b=b))\nhtmls += ['<table><tr><td>A<table><tr><td>B</td><td>C</td></tr></table>D</td><td>E</td></tr></table>', '<ul><li><ul><li></li><li>🇨🇷</li></ul></li></ul>', '<p><a href=\"x\">🇨🇷</a><sup>2</sup></p>']\nfailures = []\nfor raw in htmls:\n    try:\n        result = n.normalize_field(FieldInput(JobField.JOB_DESCRIPTION,raw,SourceFormat.HTML_FRAGMENT))\n        assert not span_errors(result)\n        assert result.source.raw == raw\n        assert n.canonicalize(result) is result\n    except Exception as exc:\n        failures.append({'raw':raw, 'type':type(exc).__name__, 'error':str(exc)})\nreport = {'cases':len(htmls),'failures':failures}\nPath('/tmp/normietext-auditoria-sondas.json').write_text(json.dumps(report,ensure_ascii=False,indent=2))\nprint(json.dumps(report,ensure_ascii=False,indent=2))\n",
    "invocation": "Run from repository root with uv run --locked python -c and exec the embedded source; this imports development-only evaluation.quality."
  },
