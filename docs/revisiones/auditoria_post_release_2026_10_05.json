  "probe_source": "import itertools,json,html\nfrom pathlib import Path\nfrom normietext import FieldInput,JobField,JobTextNormalizer,SourceFormat\nfrom normietext.operations import measure_field\nfrom normietext.errors import NormalizationError\nn=JobTextNormalizer();values=['A','🚀','🇨🇷','Jo','sÃ©','\\u200b','\\u0301','©️','1️⃣','👉',' ','\\n'];failures=[];cases=0\nfor field in (JobField.JOB_TITLE,JobField.JOB_DESCRIPTION):\n for a,b in itertools.product(values,repeat=2):\n  raw='<b>'+html.escape(a)+'</b><span>'+html.escape(b)+'</span>'\n  cases+=1\n  try:\n   plain=n.normalize_field(FieldInput(field,a+b));styled=n.normalize_field(FieldInput(field,raw,SourceFormat.HTML_FRAGMENT))\n   assert styled.text==plain.text,(plain.text,styled.text)\n   assert n.canonicalize(styled) is styled\n  except Exception as exc:failures.append({'field':field.value,'a':a,'b':b,'type':type(exc).__name__,'error':str(exc)})\ninvalid=[]\nfor value in (None,'Python',b'Python'):\n row={'input_type':type(value).__name__}\n for name,fn in [('api',n.normalize_field),('measurement',lambda x:measure_field(n,x))]:\n  try:\n   r=fn(value);row[name]={'returned':str(getattr(r,'error',None))}\n  except Exception as e:row[name]={'exception':type(e).__name__,'code':str(getattr(e,'code',None)),'message':str(e)}\n invalid.append(row)\nreport={'transparent_inline_cases':cases,'failures':failures,'invalid_input_observations':invalid}\nPath('/tmp/normietext-audit-20261005-probes.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\nprint(json.dumps(report,ensure_ascii=False,indent=2))\n",
